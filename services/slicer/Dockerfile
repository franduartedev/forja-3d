FROM node:22-trixie-slim

ARG DEBIAN_FRONTEND=noninteractive

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/tmp/forja-slicer-home \
    XDG_CONFIG_HOME=/tmp/forja-slicer-home/.config \
    XDG_CACHE_HOME=/tmp/forja-slicer-home/.cache \
    HOST=0.0.0.0 \
    PORT=3001

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        prusa-slicer \
        xauth \
        xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" /work \
    && chown -R node:node "$HOME" /work \
    && command -v prusa-slicer >/dev/null

COPY --chown=node:node services/slicer/smoke-test/ /opt/forja-slicer/smoke-test/
COPY --chown=node:node services/slicer/src/ /opt/forja-slicer/src/

WORKDIR /work

USER node

# Esta prueba corre un slicing real durante el build. El build falla si
# PrusaSlicer no termina, genera un archivo vacío o no produce G-code.
RUN timeout --signal=TERM --kill-after=5s 120s \
        xvfb-run --auto-servernum \
        --server-args="-screen 0 1024x768x24" \
        prusa-slicer \
        --load /opt/forja-slicer/smoke-test/biqu-b1-smoke.ini \
        --export-gcode \
        --output /tmp/forja-smoke-test.gcode \
        /opt/forja-slicer/smoke-test/cube-20mm.stl \
    && test -s /tmp/forja-smoke-test.gcode \
    && test "$(stat --format=%s /tmp/forja-smoke-test.gcode)" -gt 1024 \
    && grep --quiet '^; generated by PrusaSlicer' /tmp/forja-smoke-test.gcode \
    && grep --extended-regexp --quiet '^G[01][[:space:]]' /tmp/forja-smoke-test.gcode \
    && grep --extended-regexp --quiet '^G1.*[[:space:]]E[-+]?[0-9]' /tmp/forja-smoke-test.gcode \
    && rm /tmp/forja-smoke-test.gcode

EXPOSE 3001

CMD ["node", "/opt/forja-slicer/src/server.mjs"]
