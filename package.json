{
  "name": "forja-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Editor web abierto para diseñar piezas 3D y exportarlas en STL, 3MF o STEP.",
  "license": "AGPL-3.0-only",
  "homepage": "https://forja-3d.frn81.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franduartedev/forja-3d.git"
  },
  "bugs": {
    "url": "https://github.com/franduartedev/forja-3d/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots=all",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "typecheck": "bash scripts/sites-env.sh -- tsc --noEmit",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "manifold-3d": "^3.5.1",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.179.1",
    "three-bvh-csg": "^0.0.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module",
  "displayName": "FORJA - Diseño 3D asistido"
}
